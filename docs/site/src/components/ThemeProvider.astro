---
// Light-default ThemeProvider compatible with Starlight's native ThemeSelect.
// Defaults to light mode when no explicit preference is saved in localStorage,
// while honoring 'light' or 'dark' chosen via the navbar theme switcher.
---

<script is:inline>
  window.StarlightThemeProvider = (() => {
    const storedTheme =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme =
      storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : 'light';
    document.documentElement.dataset.theme = theme;
    const provider = {
      updatePickers(newTheme = theme) {
        const value = newTheme === 'dark' || newTheme === 'light' ? newTheme : theme;
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = value;
        });
      },
    };
    document.addEventListener('DOMContentLoaded', () => provider.updatePickers(theme));
    return provider;
  })();
</script>
